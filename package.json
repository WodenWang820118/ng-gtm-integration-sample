{
  "name": "ng-gtm-integration-sample",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "on-emulator": "ng serve --disable-host-check --host 0.0.0.0",
    "backend": "json-server --watch db.json",
    "build": "ng build --configuration production --base-href https://wodenwang820118.github.io/ng-gtm-integration-sample/browser --optimization --output-path=dist/ng-gtm-integration-sample",
    "build-file": "ng build --configuration production --base-href ./",
    "deploy": "ngh --dir=dist/ng-gtm-integration-sample/browser",
    "build-github": "npm run build && npm run deploy",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "bundle-report": "ng build --configuration production --source-map && source-map-explorer dist/ng-gtm-integration-sample/browser/*.js"
  },
  "private": true,
  "dependencies": {
    "@amcharts/amcharts5": "^5.13.5",
    "@amcharts/amcharts5-fonts": "^5.0.1",
    "@amcharts/amcharts5-geodata": "^5.1.5",
    "@angular/animations": "^20.1.7",
    "@angular/common": "^20.1.7",
    "@angular/compiler": "^20.1.7",
    "@angular/core": "^20.1.7",
    "@angular/forms": "^20.1.7",
    "@angular/platform-browser": "^20.1.7",
    "@angular/platform-browser-dynamic": "^20.1.7",
    "@angular/router": "^20.1.7",
    "@angular/service-worker": "^20.1.7",
    "@angular/youtube-player": "^20.1.6",
    "@primeuix/themes": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "country-state-city": "^3.2.1",
    "dexie": "^4.0.11",
    "firebase": "^12.1.0",
    "json-server": "^0.17.4",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.1",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.1.12",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.1.6",
    "@angular/cli": "^20.1.6",
    "@angular/compiler-cli": "^20.1.7",
    "@types/jasmine": "~5.1.8",
    "@types/uuid": "^10.0.0",
    "angular-cli-ghpages": "^2.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "shx": "^0.4.0",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.8.0"
  }
}